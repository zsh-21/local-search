{
  "name": "file-search",
  "version": "1.0.1",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "clear:cache": "electron ./scripts/clear-local-cache.cjs"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "pinyin-pro": "^3.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^2.2.5",
    "sudo-prompt": "^9.2.1",
    "windows-shortcuts": "^0.1.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-window": "^2.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.1.0",
    "electron-builder": "^23.6.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.localsearch.app",
    "productName": "File Search",
    "asar": true,
    "compression": "maximum",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "buildResources": "build",
      "output": "release-build"
    },
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
